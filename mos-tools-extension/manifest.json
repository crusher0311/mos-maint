{
  "manifest_version": 3,
  "name": "MOS Tools",
  "version": "1.0.7",
  "description": "Maintenance planning and job management for automotive shops",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "webRequest"
  ],
  "host_permissions": [
    "https://shop.tekmetric.com/*",
    "https://sandbox.tekmetric.com/*",
    "https://cba.tekmetric.com/*",
    "https://*.protractor.com/*",
    "https://*.autoflow.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shop.tekmetric.com/*",
        "https://sandbox.tekmetric.com/*",
        "https://cba.tekmetric.com/*"
      ],
      "js": ["adapters/tekmetric-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MOS Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
