modules = ["nodejs-20", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MOS Maintenance MVP"

[[workflows.workflow]]
name = "MOS Maintenance MVP"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["mongodb"]

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
DATAONE_API_URL = "http://3.144.191.161:3000"
CARFAX_POST_URL = "https://servicesocket.carfax.com/data/1"
CARFAX_PDI = "207625C61DD1C38E"

[userenv.development]
DEV_AUTO_LOGIN = "true"
DEV_SHOP_ID = "1"
DEV_USER_EMAIL = "dev@example.com"
