Email": "wil_rod21@hotmail.com", "OwnerSmsPhone": null, "TextMessagePreferred": false, "Ymm": "2009 Infiniti G Sedan", "Vin": "JNKCV61F79M359337", "License": "4AZX70", "Odometer": 214814, "OdometerUnit": "miles", "RepairOrderId": "234684", "ServiceAdvisorId": 1700074188, "ServiceAdvisorFirstName": "John", "ServiceAdvisorLastName": "Garrant", "ServiceAdvisorImageUrl": null, "TechnicianFirstName": "Brian", "TechnicianLastName": "Bessette", "TechnicianImageUrl": null, "RecallAlert": null, "ImageUrl": "https://autovitals.blob.core.windows.net/638/1247484294/639160111474682582.jpg"}], "Table4": [{"JobId": 1524876969, "Name": "Labor", "Details": null, "GroupId": 1180778227, "GroupName": "Fluid Leak Concern", "GroupDetails": "Coolant leaking. Has had to continually add coolant. Heat works ok but not always. Can also smell coolant smell.", "Hours": 0.0, "ShopNotes": "", "CustomerNotes": "", "CustomerNotesApproved": null, "JobToSend": true, "Authorized": true}, {"JobId": 1524883901, "Name": "Labor", "Details": null, "GroupId": 1180782590, "GroupName": "PMI Inspection", "GroupDetails": "-- Inspection Results from AutoVitals SmartFlow --\nV&F Rack Attack*, rev. 1\nhttps://avlink.io/l/49vk87X", "Hours": 0.0, "ShopNotes": "", "CustomerNotes": "", "CustomerNotesApproved": null, "JobToSend": true, "Authorized": true}, {"JobId": 1524876968, "Name": "Labor", "Details": null, "GroupId": 1180778228, "GroupName": "Diagnose Fluid Leak Concern", "GroupDetails": "Initial diagnosis, testing and inspection of the specific vehicle system as required. Perform road test where applicable. Report test result(s), system fault(s), component(s) failure and required repair(s). Additional diagnosis and testing time may be required at additional charges. \n-- Technician Notes from AutoVitals SmartFlow --\nPressure tested cooling system and was able to verify concern. Upon further inspection, found one of the heater hoses in the back leaking from the clamp. It would drip onto the exhaust, causing a coolant smell. Tighten up the clamp some more and the leak stopped. Pressure tested again and no more leak.", "Hours": 0.0, "ShopNotes": "", "CustomerNotes": "Pressure tested cooling system and was able to verify concern. Upon further inspection, found one of the heater hoses in the back leaking from the clamp. It would drip onto the exhaust, causing a coolant smell. Tighten up the clamp some more and the leak stopped. Pressure tested again and no more leak.   ", "CustomerNotesApproved": true, "JobToSend": true, "Authorized": true}], "Table5": [], "Table6": [{"JobId": 1524876968, "FileName": "639081458043438389.jpg", "FileUrl": "https://autovitals.blob.core.windows.net/638/1239384688/639081458043438389.jpg", "FrameImageFileUrl": null, "Type": 0, "VisibleToCustomer": true, "ShopNotes": "", "CustomerNotes": "", "CustomerNotesApproved": null, "CaptionTime": null, "CaptionRightAligned": false, "Muted": false, "Circled": false, "Duration": null, "CreationTimestamp": "2026-03-03T14:43:24.523", "Edited": false}, {"JobId": 1524876968, "FileName": "639081458626817505.mp4", "FileUrl": "https://autovitals.blob.core.windows.net/638/1239384688/639081458626817505.mp4", "FrameImageFileUrl": "https://autovitals.blob.core.windows.net/638/1239384688/639081458580753781.jpg", "Type": 2, "VisibleToCustomer": true, "ShopNotes": "", "CustomerNotes": "", "CustomerNotesApproved": null, "CaptionTime": null, "CaptionRightAligned": false, "Muted": false, "Circled": true, "Duration": null, "CreationTimestamp": "2026-03-03T14:44:22.957", "Edited": true}, {"JobId": 1524876969, "FileName": "639081639404227878.mov", "FileUrl": "https://autovitals.blob.core.windows.net/638/1239384688/639081639404227878.mov", "FrameImageFileUrl": "https://autovitals.blob.core.windows.net/638/1239384688/639081639256468706.jpg", "Type": 2, "VisibleToCustomer": true, "ShopNotes": "", "CustomerNotes": "", "CustomerNotesApproved": null, "CaptionTime": null, "CaptionRightAligned": false, "Muted": false, "Circled": true, "Dura