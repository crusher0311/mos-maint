tion", "Index": 5}], "Table11": [{"TopicId": 1700878556, "Name": "No Longer Performing as Designed", "CustomerNote": "Shocks and struts are designed to keep tires in contact with the road to maximize traction. As shocks and struts weaken, they have less ability to keep the tires firmly in contact with the road, thus increasing tire wear, causing uneven tire wear, and reducing the traction of the vehicle. According to the manufacturers, shocks and struts are expected to last approximately 75,000 miles.", "Title": "Shocks and Struts Video", "VideoUrl": "https://autovitalsinc.wistia.com/medias/yhskk3z4ib", "ThumbnailUrl": "https://embed-ssl.wistia.com/deliveries/fa868f9419c6181da9ae4abc1258a6c932d140d4/file.jpg"}, {"TopicId": 1700878561, "Name": "Rusty", "CustomerNote": "The main purpose of a vehicle's exhaust system is to safely channel exhaust gases away from the engine, reduce emissions, and minimize noise produced by the engine's operation.", "Title": null, "VideoUrl": "https://www.srvc.video/4UNr", "ThumbnailUrl": null}, {"TopicId": 1700878692, "Name": "Engine Oil Very Dirty", "CustomerNote": "", "Title": null, "VideoUrl": null, "ThumbnailUrl": null}, {"TopicId": 1700878688, "Name": "No O/C Sticker", "CustomerNote": "", "Title": "Oil Change Service Video", "VideoUrl": "https://autovitalsinc.wistia.com/medias/vtydxt3xmt", "ThumbnailUrl": "https://embed-ssl.wistia.com/deliveries/4545d8c39638ca1107131a0cca85866eb201ba3b.jpg"}, {"TopicId": 1700878562, "Name": "Coolant", "CustomerNote": "Engine coolant or Anti-Freeze helps regulate an even operating temperature in your engine. If the engine temperature gets too high severe and catastrophic engine damage can occur. A leak in your engines cooling system should be addressed immediately to prevent damage.", "Title": null, "VideoUrl": null, "ThumbnailUrl": null}, {"TopicId": 1700878558, "Name": "Axle Boot(s) Torn", "CustomerNote": "The constant velocity (CV) boot protects the axles joint from dirt and debris and keeps the lubrication in the joint. A damaged CV boot can leak lubricant and allow dirt and debris to enter the joint damaging the axle. If the joint breaks you will lose power to your drive wheels.", "Title": "Drive Axle", "VideoUrl": "https://autovitalsinc.wistia.com/medias/ygjzkvv2zx", "ThumbnailUrl": "https://autovitals.blob.core.windows.net/000/0/639185838488948101.jpg"}, {"TopicId": 1700878553, "Name": "Rear Brakes - Low Pad Life", "CustomerNote": "Brake pads press against the brake rotors to slow and stop the vehicle. When brake pads wear down, they are less able to perform effectively. This can lead to longer stopping distances and increase the risk of an accident.", "Title": "Brake Pads Video", "VideoUrl": "https://autovitalsinc.wistia.com/medias/2xk15jd9ag", "ThumbnailUrl": "https://embed-ssl.wistia.com/deliveries/8c26806099117e459173e70f3055ea58eb8e70ce/file.jpg"}, {"TopicId": 1700878562, "Name": "Transmission Fluid", "CustomerNote": "The transmission converts engine power into driving power, the fluid is the lifeblood of this unit. Transmission hydraulic fluid lubricates, cools and is a vital component of internal functions of the transmission. A loss of fluid can cause severe damage and may cause your vehicle to lose the ability to propel itself down the road.", "Title": null, "VideoUrl": null, "ThumbnailUrl": null}, {"TopicId": 1700878537, "Name": "Terminals Loose", "CustomerNote": "", "Title": null, "VideoUrl": null, "ThumbnailUrl": null}, {"TopicId": 1700878520, "Name": "Cabin Air Filter Not Inspected Due to Location", "CustomerNote": "The cabin air filter in a vehicle helps remove harmful pollutants, including pollen and dust, from the air you breathe within the vehicle.. Depending on your parking and driving conditions, these filters should be replaced every 15,000 to 20,000 miles.", "Title": "Cabin Air Filter Video", "VideoUrl": "https://autovitalsinc.wistia.com/medias/w2fm5edtbc", "ThumbnailUrl": "https://autovitals.blob.core.windows.net/000/0/639185838200877654.jpg"}, {"TopicId": 1700878536, "Name": "Life Time Air Filter - Needs Cleaning", "CustomerNote": "Engine air filters capture dirt and other particles preventing them from entering your engine and causing premature wear or damage.", "Title": null, "VideoUrl": null, "ThumbnailUrl": null}, {"TopicId": 1700878556, "Name": "Leaking Level 2", "CustomerNote": "", "Title": null, "VideoUrl": null, "ThumbnailUrl": null}, {"TopicId": 1700878552, "Name": "Uneven Wear", "CustomerNote": "It's important to address these issues promptly to ensure your vehicle's braking system works safely and effectively. We recommend having a brake inspection to determine the exact cause and to perform the necessary repairs.", "Title": null, "VideoUrl": null, "ThumbnailUrl": null}, {"TopicId": 1700878537, "Name": "Battery Hold Down Need Attention", "CustomerNote": "Jostling and vibration can lead to premature failure of a battery and cause a no-start condition", "Title": null, "VideoUrl": null, "ThumbnailUrl": null}, {"TopicId": 1700878562, "Name": "Power Steering", "CustomerNote": "There are several components in the hydraulic power steering system that rely on the pressurized fluid to assist with turning your vehicle. Low fluid can cause damage to several components in the system and since the vehicle was designed to have power steering it can be nearly impossible to steer without the assist.", "Title": null, "VideoUrl": null, "ThumbnailUrl": null}, {"TopicId": 1700878557, "Name": "Other", "CustomerNote": "", "Title": null, "VideoUrl": null, "ThumbnailUrl": null}, {"TopicId": 1700878553, "Name": "Other", "CustomerNote": "", "Title": null, "VideoUrl": null, "ThumbnailUrl": null}], "Table12": [{"TopicId": 1700878536, "Name": "Clean Air Filter"}, {"TopicId": 1700878556, "Name": "Strut Assembly, Front"}, {"TopicId": 1700878553, "Name": "Brake System Inspection"}, {"TopicId": 1700878548, "Name": "Tire Rotation w/ TPMS Relearn"}, {"TopicId": 1700878556, "Name": "Shock Absorber, Rear"}, {"TopicId"