{
  "manifest_version": 3,
  "name": "MOS AutoVitals Sync",
  "version": "1.0.0",
  "description": "Sync Digital Vehicle Inspection (DVI) data from AutoVitals to MOS Maintenance",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.autovitals.com/*",
    "https://*.autovitalsapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.autovitals.com/*", "https://*.autovitalsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
