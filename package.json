{
  "name": "mos-maintenance-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p ${PORT:-5000} -H 0.0.0.0",
    "lint": "eslint",
    "vercel-build": "next build",
    "backfill:customers": "tsx lib/scripts/backfill-customers.ts",
    "migrate:shopid": "tsx scripts/migrate-shopid-to-numbers.ts",
    "setup:dev": "cp .env.template .env.local && echo 'Please edit .env.local with your configuration'",
    "admin:promote": "node -e \"const email = process.argv[1]; const token = process.env.ADMIN_TOKEN; if (!email || !token) { console.error('Usage: npm run admin:promote <email>'); process.exit(1); } fetch('http://localhost:3000/api/admin/promote-user', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, adminToken: token }) }).then(r => r.json()).then(console.log).catch(console.error);\""
  },
  "dependencies": {
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.1",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "fast-csv": "^5.0.5",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.541.0",
    "mongodb": "^6.19.0",
    "mongoose": "^8.18.0",
    "next": "14.2.5",
    "openai": "^6.15.0",
    "p-limit": "^7.2.0",
    "p-retry": "^7.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ssh2-sftp-client": "^12.0.1",
    "stripe": "^20.1.0",
    "unzipper": "^0.12.3",
    "zod": "^4.2.1",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.3.0",
    "@types/react": "19.1.11",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
